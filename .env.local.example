# Copy this file to .env.local and fill in your own keys.
# .env.local is already in .gitignore — never commit real keys.

# Get a free key (no credit card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Get a free key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=
# Get a free key (no credit card): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Secret used to encrypt session cookies. Use at least 32 random characters,
# e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROMPTBENCH_SESSION_SECRET=
